{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2022",

    "types": ["node"],

    "strict": true,

    "allowSyntheticDefaultImports": true,

    "verbatimModuleSyntax": true,

    "isolatedModules": true,

    "skipLibCheck": true,

    "typeRoots": ["./node_modules/@types", "./src/types"]
  },

  "include": ["src"]
}
